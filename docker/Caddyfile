{
	on_demand_tls {
		ask http://web:3000/api/tracking-domain/check
	}
}

{$DOMAIN} {
	reverse_proxy web:3000
}

# Verified tracking domains (a CNAME to {$DOMAIN}): certificates on demand, tracking and unsubscribe paths only
https:// {
	tls {
		on_demand
	}
	@track path /t/* /u/*
	reverse_proxy @track web:3000
	respond 404
}
