# local = Docker Compose on your machine, vps = public server
MODE=local
DATABASE_URL=postgresql://rightnow:rightnow@localhost:5432/rightnow
DB_POOL_MAX=10
# 32 random bytes, base64 (openssl rand -base64 32). Back it up with the database.
ENCRYPTION_KEY=
# openssl rand -base64 32 (min 32 chars)
BETTER_AUTH_SECRET=
# Required to create the first owner account (min 16 chars, keep it secret)
SETUP_TOKEN=
APP_URL=http://localhost:3000
WORKER_HEALTH_PORT=8081
SYNC_MAX_STALENESS_SEC=300
# VPS mode only: public domain Caddy serves (DNS must point here); APP_URL must be https://<DOMAIN>
DOMAIN=
# Optional, empty = "rightnow". URL-safe only (openssl rand -hex 24). Must be set before the first start:
# changing it later does not change the existing database user.
POSTGRES_PASSWORD=
# Mail providers (all optional). Redirect URIs: ${APP_URL}/api/v1/oauth/google/callback and .../microsoft/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_TENANT=common
# VPS mode: set to 1 to allow IMAP/SMTP hosts on private networks
# ALLOW_PRIVATE_MAIL_HOSTS=1
# Tests/e2e only (refused when MODE=vps): fake mailboxes instead of real providers
# MAIL_PROVIDER_FAKE=1
# FAKE_MAIL_DIR=
