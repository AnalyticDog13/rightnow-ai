generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id            String                @id @default(cuid())
  name          String
  slug          String                @unique
  createdAt     DateTime              @default(now())
  // better-auth organization fields (Workspace is the organization model)
  logo          String?
  metadata      String?
  members       Member[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]
  emailAccounts EmailAccount[]
  oauthSessions OAuthSession[]
  dailyUsage    WorkspaceDailyUsage[]
  leads         Lead[]
  leadLabels    LeadLabel[]
  leadLists     LeadList[]
  suppressions  Suppression[]
  importJobs    ImportJob[]
}

// better-auth tables. Roles are stored lowercase: owner | admin | member | viewer.
model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
}

model Session {
  id                   String   @id
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

model Member {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invitation {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        String?
  status      String    @default("pending")
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  inviterId   String
  inviter     User      @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId     String?
  action      String
  target      String?
  meta        Json?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  prefix      String
  hash        String    @unique
  scopes      String[]
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([workspaceId])
}

model WorkerBoot {
  id              String    @id @default(cuid())
  startedAt       DateTime  @default(now())
  hostname        String
  lastHeartbeatAt DateTime  @default(now())
  stoppedAt       DateTime?
}

enum AccountProvider {
  GMAIL
  MICROSOFT
  SMTP
}

enum AccountStatus {
  CONNECTED
  ERROR
  DISCONNECTED
}

enum AccountLifecycle {
  ACTIVE
  INACTIVE
  REWARMING
  PAUSED
  NEEDS_ATTENTION
}

enum SyncState {
  IDLE
  SYNCING
  FAILED
}

enum AutofixState {
  NONE
  IN_PROGRESS
  FAILED
  SUCCEEDED
}

enum CapTier {
  GMAIL_WORKSPACE
  GMAIL_CONSUMER
  MS365
  OUTLOOK_COM
  SMTP
}

enum OAuthStatus {
  PENDING
  SUCCESS
  ERROR
  EXPIRED
}

enum CnameStatus {
  UNVERIFIED
  VERIFIED
  FAILED
}

// Partial unique index (workspaceId, lower(email)) WHERE deletedAt IS NULL lives in the `accounts` migration (raw SQL).
model EmailAccount {
  id                     String              @id @default(cuid())
  workspaceId            String
  workspace              Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider               AccountProvider
  email                  String // lowercased
  fromName               String
  firstName              String
  lastName               String
  replyTo                String?
  signature              String?
  tags                   String[]
  credentialsEnc         String? // AES-256-GCM JSON; null after disconnect; never returned by any API
  // Bumped by every credential replacement (disconnect, soft delete, reconnect): an in-flight refresh then writes nothing (R2-I1).
  credentialGen          Int                 @default(0)
  status                 AccountStatus       @default(CONNECTED)
  lifecycle              AccountLifecycle    @default(ACTIVE)
  pausedUntil            DateTime?
  capTier                CapTier
  providerCap            Int
  dailyLimit             Int                 @default(30)
  minGapSec              Int                 @default(0)
  randomGapSec           Int                 @default(0)
  timezone               String              @default("UTC")
  slowRamp               Boolean             @default(false)
  rampStartVolume        Int                 @default(2)
  rampIncrementPerDay    Int                 @default(2)
  rampStartedAt          DateTime?
  historyImportDays      Int                 @default(30)
  nextSendAt             DateTime            @default(now())
  lastSentAt             DateTime?
  lastCampaignActivityAt DateTime?
  lastError              Json?
  lastErrorAt            DateTime?
  errorCount24h          Int                 @default(0)
  autofixState           AutofixState        @default(NONE)
  autofixAt              DateTime?
  refreshLeaseId         String?
  refreshLeaseUntil      DateTime?
  syncState              SyncState           @default(IDLE)
  syncCursor             Json?
  lastSyncCompletedAt    DateTime?
  healthScore            Int?
  trackingDomain         String?
  trackingDomainStatus   CnameStatus         @default(UNVERIFIED)
  appendToSent           Boolean             @default(true)
  createdAt              DateTime            @default(now())
  deletedAt              DateTime?
  dailyUsage             AccountDailyUsage[]

  @@index([workspaceId])
}

model OAuthSession {
  id                 String          @id @default(cuid())
  workspaceId        String
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUserId    String
  provider           AccountProvider
  stateHash          String          @unique
  codeVerifierEnc    String
  reconnectAccountId String?
  status             OAuthStatus     @default(PENDING)
  errorCode          String?
  accountId          String?
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime        @default(now())

  @@index([workspaceId])
  @@index([createdAt])
}

model AccountDailyUsage {
  accountId String
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  day       DateTime     @db.Date
  sent      Int          @default(0)
  reserved  Int          @default(0)

  @@id([accountId, day])
}

model WorkspaceDailyUsage {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  day         DateTime  @db.Date
  sent        Int       @default(0)
  reserved    Int       @default(0)

  @@id([workspaceId, day])
}

enum VerificationStatus {
  NOT_VERIFIED
  VERIFIED
  PENDING
  PENDING_JOB
  INVALID
  RISKY
  CATCH_ALL
  JOB_CHANGE
}

enum EspType {
  GOOGLE
  MICROSOFT
  ZOHO
  YAHOO
  YANDEX
  OTHER
  NOT_FOUND
  IN_QUEUE
}

enum EnrichmentStatus {
  ENRICHED
  PENDING
  NOT_AVAILABLE
  ERROR
}

enum SuppressionKind {
  EMAIL
  DOMAIN
}

enum SuppressionReason {
  UNSUBSCRIBE
  HARD_BOUNCE
  COMPLAINT
  MANUAL
  NOT_INTERESTED
  GDPR_ERASURE
}

enum ImportStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// Partial unique index (workspaceId, email) WHERE deletedAt IS NULL lives in the `leads` migration (raw SQL).
model Lead {
  id                   String             @id @default(cuid())
  workspaceId          String
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email                String // lowercased
  firstName            String?
  lastName             String?
  companyName          String?
  companyDomain        String?
  jobTitle             String?
  website              String?
  industry             String?
  phone                String?
  personalization      String?
  customFields         Json               @default("{}")
  tags                 String[]
  labels               String[]
  interestStatus       Int?
  verificationStatus   VerificationStatus @default(NOT_VERIFIED)
  espType              EspType            @default(IN_QUEUE)
  esg                  String?
  enrichmentStatus     EnrichmentStatus?
  plValue              Decimal?
  ownerId              String?
  source               String?
  lawfulBasis          String?
  country              String?
  importJobId          String?
  emailsSent           Int                @default(0)
  opens                Int                @default(0)
  clicks               Int                @default(0)
  replies              Int                @default(0)
  lastContactedAt      DateTime?
  lastOpenAt           DateTime?
  lastReplyAt          DateTime?
  lastClickAt          DateTime?
  lastInterestChangeAt DateTime?
  lastTouchAt          DateTime?
  lastSenderAccountId  String?
  lastEngagement       Json?
  mergedIntoId         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @default(now()) @updatedAt
  deletedAt            DateTime?
  listMembers          LeadListMember[]

  @@index([workspaceId, createdAt, id])
  @@index([workspaceId, companyDomain])
}

model LeadLabel {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  color         String
  positive      Boolean   @default(false)
  aiDescription String?

  @@unique([workspaceId, name])
}

model LeadList {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime         @default(now())
  members     LeadListMember[]

  @@unique([workspaceId, name])
}

model LeadListMember {
  listId String
  list   LeadList @relation(fields: [listId], references: [id], onDelete: Cascade)
  leadId String
  lead   Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@id([listId, leadId])
  @@index([leadId])
}

model Suppression {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        SuppressionKind
  value       String? // null after GDPR erasure
  valueHash   String // sha256 hex of the lowercased email or domain
  reason      SuppressionReason
  source      String?
  createdAt   DateTime          @default(now())

  @@unique([workspaceId, kind, valueHash])
}

model ImportJob {
  id                  String       @id @default(cuid())
  workspaceId         String
  workspace           Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById         String
  status              ImportStatus @default(PENDING)
  fileName            String
  data                Bytes? // cleared when DONE/FAILED
  mapping             Json
  options             Json
  confirmedAuthorized Boolean
  source              String
  lawfulBasis         String
  total               Int          @default(0)
  imported            Int          @default(0)
  attached            Int          @default(0)
  skipped             Json         @default("{}")
  progress            Int          @default(0)
  error               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  finishedAt          DateTime?

  @@index([status, createdAt])
}
