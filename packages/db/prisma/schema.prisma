generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  createdAt            DateTime              @default(now())
  // better-auth organization fields (Workspace is the organization model)
  logo                 String?
  metadata             String?
  members              Member[]
  invitations          Invitation[]
  auditLogs            AuditLog[]
  apiKeys              ApiKey[]
  emailAccounts        EmailAccount[]
  oauthSessions        OAuthSession[]
  dailyUsage           WorkspaceDailyUsage[]
  leads                Lead[]
  leadLabels           LeadLabel[]
  leadLists            LeadList[]
  suppressions         Suppression[]
  importJobs           ImportJob[]
  campaigns            Campaign[]
  scheduledMessages    ScheduledMessage[]
  threads              Thread[]
  notes                Note[]
  macros               Macro[]
  inboxViews           InboxView[]
  domainChecks         DomainCheck[]
  timezone             String                @default("UTC")
  physicalAddress      String?
  dailyCap             Int? // null = no workspace cap
  perCompanyDailyLimit Int?
  disableOpenTracking  Boolean               @default(false)
  firstEmailTextOnly   Boolean               @default(false)
  bounceThresholdPct   Float                 @default(3) // 0.5-20 (D34)
  healthSlowdownPct    Int                   @default(50) // 10-90 (D34)
}

// better-auth tables. Roles are stored lowercase: owner | admin | member | viewer.
model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
}

model Session {
  id                   String   @id
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

model Member {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invitation {
  id          String    @id
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        String?
  status      String    @default("pending")
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  inviterId   String
  inviter     User      @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId     String?
  action      String
  target      String?
  meta        Json?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  prefix      String
  hash        String    @unique
  scopes      String[]
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([workspaceId])
}

model WorkerBoot {
  id              String    @id @default(cuid())
  startedAt       DateTime  @default(now())
  hostname        String
  lastHeartbeatAt DateTime  @default(now())
  stoppedAt       DateTime?
}

enum AccountProvider {
  GMAIL
  MICROSOFT
  SMTP
}

enum AccountStatus {
  CONNECTED
  ERROR
  DISCONNECTED
}

enum AccountLifecycle {
  ACTIVE
  INACTIVE
  REWARMING
  PAUSED
  NEEDS_ATTENTION
}

enum SyncState {
  IDLE
  SYNCING
  FAILED
}

enum AutofixState {
  NONE
  IN_PROGRESS
  FAILED
  SUCCEEDED
}

enum CapTier {
  GMAIL_WORKSPACE
  GMAIL_CONSUMER
  MS365
  OUTLOOK_COM
  SMTP
}

enum OAuthStatus {
  PENDING
  SUCCESS
  ERROR
  EXPIRED
}

enum CnameStatus {
  UNVERIFIED
  VERIFIED
  FAILED
}

// Partial unique index (workspaceId, lower(email)) WHERE deletedAt IS NULL lives in the `accounts` migration (raw SQL).
model EmailAccount {
  id                         String              @id @default(cuid())
  workspaceId                String
  workspace                  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider                   AccountProvider
  email                      String // lowercased
  fromName                   String
  firstName                  String
  lastName                   String
  replyTo                    String?
  signature                  String?
  tags                       String[]
  credentialsEnc             String? // AES-256-GCM JSON; null after disconnect; never returned by any API
  // Bumped by every credential replacement (disconnect, soft delete, reconnect): an in-flight refresh then writes nothing (R2-I1).
  credentialGen              Int                 @default(0)
  status                     AccountStatus       @default(CONNECTED)
  lifecycle                  AccountLifecycle    @default(ACTIVE)
  pausedUntil                DateTime?
  capTier                    CapTier
  providerCap                Int
  dailyLimit                 Int                 @default(30)
  minGapSec                  Int                 @default(0)
  randomGapSec               Int                 @default(0)
  timezone                   String              @default("UTC")
  slowRamp                   Boolean             @default(false)
  rampStartVolume            Int                 @default(2)
  rampIncrementPerDay        Int                 @default(2)
  rampStartedAt              DateTime?
  historyImportDays          Int                 @default(30)
  nextSendAt                 DateTime            @default(now())
  lastSentAt                 DateTime?
  lastCampaignActivityAt     DateTime?
  lastError                  Json?
  lastErrorAt                DateTime?
  errorCount24h              Int                 @default(0)
  autofixState               AutofixState        @default(NONE)
  autofixAt                  DateTime?
  refreshLeaseId             String?
  refreshLeaseUntil          DateTime?
  syncState                  SyncState           @default(IDLE)
  syncCursor                 Json?
  lastSyncCompletedAt        DateTime?
  // P4-T05 sync: a row lease (it must outlive network calls), so no advisory lock
  syncLeaseId                String?
  syncLeaseUntil             DateTime?
  lastSyncAttemptAt          DateTime?
  syncErrors                 Int                 @default(0)
  syncProgress               Json? // {mode, folder, pageToken, since, cursor, startedAt, fetched} during HISTORICAL/FULL; null when idle
  healthScore                Int?
  trackingDomain             String?
  trackingDomainStatus       CnameStatus         @default(UNVERIFIED)
  appendToSent               Boolean             @default(true)
  createdAt                  DateTime            @default(now())
  deletedAt                  DateTime?
  consecutivePermanentErrors Int                 @default(0)
  // D34 health throttle: the allowance term, when it last changed (set, doubled or lifted), and the last manual resume
  healthCap                  Int?
  healthCapAt                DateTime?
  healthResetAt              DateTime?
  // D36: display-only (idle time counts campaign sends, Rev 2 I6)
  lastWarmupAt               DateTime?
  warmupSettings             WarmupSettings?
  warmupSent                 WarmupMessage[]     @relation("WarmupFrom")
  warmupReceived             WarmupMessage[]     @relation("WarmupTo")
  healthSnapshots            HealthSnapshot[]
  dailyUsage                 AccountDailyUsage[]
  campaigns                  CampaignAccount[]
  scheduledMessages          ScheduledMessage[]
  threads                    Thread[]
  syncRuns                   SyncRun[]

  @@index([workspaceId])
}

model OAuthSession {
  id                 String          @id @default(cuid())
  workspaceId        String
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUserId    String
  provider           AccountProvider
  stateHash          String          @unique
  codeVerifierEnc    String
  reconnectAccountId String?
  status             OAuthStatus     @default(PENDING)
  errorCode          String?
  accountId          String?
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime        @default(now())

  @@index([workspaceId])
  @@index([createdAt])
}

model AccountDailyUsage {
  accountId String
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  day       DateTime     @db.Date
  sent      Int          @default(0)
  reserved  Int          @default(0)

  @@id([accountId, day])
}

model WorkspaceDailyUsage {
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  day         DateTime  @db.Date
  sent        Int       @default(0)
  reserved    Int       @default(0)

  @@id([workspaceId, day])
}

enum VerificationStatus {
  NOT_VERIFIED
  VERIFIED
  PENDING
  PENDING_JOB
  INVALID
  RISKY
  CATCH_ALL
  JOB_CHANGE
}

enum EspType {
  GOOGLE
  MICROSOFT
  ZOHO
  YAHOO
  YANDEX
  OTHER
  NOT_FOUND
  IN_QUEUE
}

enum EnrichmentStatus {
  ENRICHED
  PENDING
  NOT_AVAILABLE
  ERROR
}

enum SuppressionKind {
  EMAIL
  DOMAIN
}

enum SuppressionReason {
  UNSUBSCRIBE
  HARD_BOUNCE
  COMPLAINT
  MANUAL
  NOT_INTERESTED
  GDPR_ERASURE
}

enum ImportStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// Partial unique index (workspaceId, email) WHERE deletedAt IS NULL lives in the `leads` migration (raw SQL).
model Lead {
  id                   String             @id @default(cuid())
  workspaceId          String
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email                String // lowercased
  firstName            String?
  lastName             String?
  companyName          String?
  companyDomain        String?
  jobTitle             String?
  website              String?
  industry             String?
  phone                String?
  personalization      String?
  customFields         Json               @default("{}")
  tags                 String[]
  labels               String[]
  interestStatus       Int?
  verificationStatus   VerificationStatus @default(NOT_VERIFIED)
  espType              EspType            @default(IN_QUEUE)
  esg                  String?
  enrichmentStatus     EnrichmentStatus?
  plValue              Decimal?
  ownerId              String?
  source               String?
  lawfulBasis          String?
  country              String?
  importJobId          String?
  emailsSent           Int                @default(0)
  opens                Int                @default(0)
  clicks               Int                @default(0)
  replies              Int                @default(0)
  lastContactedAt      DateTime?
  lastOpenAt           DateTime?
  lastReplyAt          DateTime?
  lastClickAt          DateTime?
  lastInterestChangeAt DateTime?
  lastTouchAt          DateTime?
  lastSenderAccountId  String?
  lastEngagement       Json?
  mergedIntoId         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @default(now()) @updatedAt
  deletedAt            DateTime?
  listMembers          LeadListMember[]
  campaignLeads        CampaignLead[]

  @@index([workspaceId, createdAt, id])
  @@index([workspaceId, companyDomain])
}

model LeadLabel {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name          String
  color         String
  positive      Boolean   @default(false)
  aiDescription String?

  @@unique([workspaceId, name])
}

model LeadList {
  id          String           @id @default(cuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime         @default(now())
  members     LeadListMember[]

  @@unique([workspaceId, name])
}

model LeadListMember {
  listId    String
  list      LeadList @relation(fields: [listId], references: [id], onDelete: Cascade)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([listId, leadId])
  @@index([leadId])
}

model Suppression {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        SuppressionKind
  value       String? // null after GDPR erasure
  valueHash   String // sha256 hex of the lowercased email or domain
  reason      SuppressionReason
  source      String?
  createdAt   DateTime          @default(now())

  @@unique([workspaceId, kind, valueHash])
}

model ImportJob {
  id                  String       @id @default(cuid())
  workspaceId         String
  workspace           Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById         String
  status              ImportStatus @default(PENDING)
  fileName            String
  data                Bytes? // cleared when DONE/FAILED
  mapping             Json
  options             Json
  confirmedAuthorized Boolean
  source              String
  lawfulBasis         String
  total               Int          @default(0)
  imported            Int          @default(0)
  attached            Int          @default(0)
  skipped             Json         @default("{}")
  progress            Int          @default(0)
  attempts            Int          @default(0) // stale resets; the job FAILS after 3
  error               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  finishedAt          DateTime?

  @@index([status, createdAt])
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
  ACCOUNTS_UNHEALTHY
  BOUNCE_PROTECT
}

model Campaign {
  id                    String               @id @default(cuid())
  workspaceId           String
  workspace             Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                  String
  status                CampaignStatus       @default(DRAFT)
  evergreen             Boolean              @default(false)
  dailyLimit            Int?
  maxNewLeadsPerDay     Int?
  perCompanyDailyLimit  Int?
  minGapSec             Int                  @default(540)
  randomGapSec          Int                  @default(300)
  stopOnReply           Boolean              @default(true)
  stopOnAutoReply       Boolean              @default(false)
  stopForCompanyOnReply Boolean              @default(false)
  trackOpens            Boolean              @default(false)
  trackClicks           Boolean              @default(false)
  textOnly              Boolean              @default(false)
  firstEmailTextOnly    Boolean              @default(false)
  prioritizeNewLeads    Boolean              @default(false)
  matchProvider         Boolean              @default(false)
  espRoutingRules       Json                 @default("[]")
  accountTags           String[]
  allowRisky            Boolean              @default(false)
  bounceProtect         Boolean              @default(true)
  unsubscribeHeader     Boolean              @default(true)
  cc                    String[]
  bcc                   String[]
  startAt               DateTime?
  endAt                 DateTime?
  ownerId               String?
  plValue               Decimal?
  tags                  String[]
  abAutoOptimize        Boolean              @default(false)
  abWinnerMetric        String?
  launchedAt            DateTime?
  bounceProtectResetAt  DateTime? // D34: BounceProtect counts only sends after the last resume out of it
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?
  schedules             CampaignSchedule[]
  accounts              CampaignAccount[]
  steps                 SequenceStep[]
  subsequences          Subsequence[]
  leads                 CampaignLead[]
  dailyUsage            CampaignDailyUsage[]
  scheduledMessages     ScheduledMessage[]

  @@index([workspaceId, status])
}

model CampaignSchedule {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name       String
  timezone   String
  days       Int // Sun = bit 0
  from       String // HH:mm
  to         String // HH:mm or 24:00
}

model CampaignAccount {
  campaignId String
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  accountId  String
  account    EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([campaignId, accountId])
  @@index([accountId])
}

enum DelayUnit {
  MINUTES
  HOURS
  DAYS
}

enum CampaignLeadState {
  QUEUED
  ACTIVE
  PAUSED
  COMPLETED
  STOPPED
}

enum StopReason {
  REPLIED
  AUTO_REPLIED
  COMPANY_REPLIED
  UNSUBSCRIBED
  BOUNCED
  SUPPRESSED
  SKIPPED
  MANUAL
  SEND_FAILED
  ACCOUNT_UNASSIGNED
  COMPLAINED
}

model Subsequence {
  id              String         @id @default(cuid())
  campaignId      String
  campaign        Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name            String
  trigger         Json
  preDelayMinutes Int            @default(0)
  dailyLimit      Int?
  active          Boolean        @default(true)
  activatedAt     DateTime?
  createdAt       DateTime       @default(now())
  steps           SequenceStep[]
  leads           CampaignLead[]

  @@index([campaignId])
}

model SequenceStep {
  id                String             @id @default(cuid())
  campaignId        String
  campaign          Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subsequenceId     String?
  subsequence       Subsequence?       @relation(fields: [subsequenceId], references: [id], onDelete: Cascade)
  order             Int
  delayValue        Int
  delayUnit         DelayUnit          @default(DAYS)
  deletedAt         DateTime?
  variants          StepVariant[]
  scheduledMessages ScheduledMessage[]

  @@index([campaignId, subsequenceId, order])
}

model StepVariant {
  id                String             @id @default(cuid())
  stepId            String
  step              SequenceStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  label             String
  subject           String
  body              String
  weight            Int                @default(1)
  active            Boolean            @default(true)
  assigned          Int                @default(0)
  scheduledMessages ScheduledMessage[]

  @@unique([stepId, label])
}

model CampaignLead {
  id            String             @id @default(cuid())
  workspaceId   String
  campaignId    String
  campaign      Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId        String
  lead          Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  subsequenceId String?
  subsequence   Subsequence?       @relation(fields: [subsequenceId], references: [id])
  state         CampaignLeadState  @default(QUEUED)
  stopReason    StopReason?
  currentStepId String?
  nextDueAt     DateTime?
  accountId     String?
  threadRef     String?
  enrolledAt    DateTime           @default(now())
  completedAt   DateTime?
  duplicateOk   Boolean            @default(false) // enrolled with allowDuplicates: exempt from the launch conflict check
  messages      ScheduledMessage[]

  @@unique([campaignId, leadId])
  @@index([campaignId, state, nextDueAt])
  @@index([workspaceId, leadId])
}

model CampaignDailyUsage {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  day        DateTime @db.Date
  sent       Int      @default(0)
  reserved   Int      @default(0)
  newLeads   Int      @default(0)

  @@id([campaignId, day])
}

enum MessageStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
  UNCERTAIN
  HELD
}

// The send queue. Claimed with FOR UPDATE SKIP LOCKED (dispatch.ts); every write is conditional on status/claimToken.
model ScheduledMessage {
  id                String        @id @default(cuid())
  workspaceId       String
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId        String
  campaign          Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignLeadId    String
  campaignLead      CampaignLead  @relation(fields: [campaignLeadId], references: [id], onDelete: Cascade)
  stepId            String
  step              SequenceStep  @relation(fields: [stepId], references: [id], onDelete: Restrict)
  // SetNull: deleting a variant never deletes or blocks send history
  variantId         String?
  variant           StepVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  accountId         String
  account           EmailAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  dueAt             DateTime
  status            MessageStatus @default(SCHEDULED)
  attempts          Int           @default(0) // send retries only
  claimErrors       Int           @default(0) // claim-side errors (Revision 3: kept apart from attempts)
  idempotencyKey    String        @unique // "${campaignLeadId}:${stepId}"
  claimToken        String?
  claimedAt         DateTime?
  claimBootId       String?
  usageDay          DateTime?     @db.Date
  wsUsageDay        DateTime?     @db.Date
  campUsageDay      DateTime?     @db.Date
  reservedUnits     Int           @default(0)
  rfcMessageId      String?
  providerMessageId String?
  providerThreadId  String?
  sentAt            DateTime?
  error             String?
  renderedSubject   String
  renderedBody      String
  renderedText      String
  cc                String[]
  bcc               String[]
  uncertainAt       DateTime?
  searchCount       Int           @default(0)
  lastSearchAt      DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  // partial ("dueAt", id) WHERE status = 'SCHEDULED' for the claim lives in the send_queue_indexes migration (raw SQL)

  @@unique([campaignLeadId, stepId]) // one row per (lead, step) at the DB level, not only via idempotencyKey
  @@index([status, dueAt])
  @@index([accountId, status])
  @@index([campaignId, status])
  @@index([stepId])
  @@index([variantId])
  @@index([workspaceId, rfcMessageId])
}

// Install-level: written only by scripts/live-verify.ts when every live step passes (D17).
model ProviderVerification {
  provider  AccountProvider @id
  passedAt  DateTime
  accountId String
  report    Json
}

enum MessageDirection {
  IN
  OUT
}

enum MessageKind {
  REPLY
  AUTO_REPLY
  BOUNCE
  UNSUBSCRIBE
  OUTBOUND
  OTHER
  COMPLAINT
}

enum ReplyCategory {
  INTERESTED
  MEETING_REQUESTED
  NOT_INTERESTED
  WRONG_PERSON
  NEUTRAL
  OUT_OF_OFFICE
  UNSUBSCRIBE
  AUTOMATED
  UNCERTAIN
}

enum BounceType {
  HARD
  SOFT
  UNKNOWN
}

enum EventType {
  ACCEPTED
  SEND_FAILED
  BOUNCE_HARD
  BOUNCE_SOFT
  BOUNCE_UNKNOWN
  UNSUBSCRIBE
  REPLY
  AUTO_REPLY
  OPEN
  CLICK
  INTEREST_CHANGED
  COMPLAINT
}

enum SyncMode {
  INCREMENTAL
  FULL
  HISTORICAL
}

// Threads are per mailbox. leadId/campaignId/campaignLeadId carry no FK: GDPR erasure deletes them explicitly.
model Thread {
  id               String         @id @default(cuid())
  workspaceId      String
  workspace        Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId        String
  account          EmailAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  providerThreadId String?
  subject          String
  leadId           String?
  campaignId       String?
  campaignLeadId   String?
  lastMessageAt    DateTime
  lastInboundAt    DateTime?
  lastInboundKind  MessageKind?
  isRead           Boolean        @default(true)
  category         ReplyCategory?
  categorySource   String? // RULE | AI | USER
  reminderAt       DateTime?
  hasAttachment    Boolean        @default(false)
  replyLeaseUntil  DateTime? // D29: an inbox reply is in flight until then (one per thread)
  deletedAt        DateTime?
  createdAt        DateTime       @default(now())
  messages         Message[]
  notes            Note[]

  @@index([workspaceId, lastMessageAt])
  @@index([accountId, providerThreadId])
  @@index([workspaceId, leadId])
  @@index([workspaceId, reminderAt])
}

model Message {
  id                 String           @id @default(cuid())
  workspaceId        String
  accountId          String
  threadId           String
  thread             Thread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  providerMessageId  String?
  rfcMessageId       String
  synthetic          Boolean          @default(false)
  inReplyTo          String?
  references         String[]
  direction          MessageDirection
  folder             String // INBOX | SENT
  fromEmail          String // lowercased
  fromName           String?
  to                 String[]
  cc                 String[]
  subject            String
  text               String?
  html               String?
  sentAt             DateTime
  kind               MessageKind
  category           ReplyCategory?
  bounceType         BounceType?
  bounceRecipient    String?
  oooUntil           DateTime?
  scheduledMessageId String?
  outsideApp         Boolean          @default(false)
  leadId             String?
  campaignId         String?
  remoteDeletedAt    DateTime?
  createdAt          DateTime         @default(now())
  attachments        Attachment[]

  @@unique([accountId, rfcMessageId])
  @@index([accountId, providerMessageId])
  @@index([threadId, sentAt])
  @@index([workspaceId, rfcMessageId])
  @@index([workspaceId, fromEmail])
}

// `data` is read only by the download route; every other read selects without it.
model Attachment {
  id          String  @id @default(cuid())
  messageId   String
  message     Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename    String
  contentType String
  size        Int
  data        Bytes?
  truncated   Boolean @default(false)

  @@index([messageId])
}

model Event {
  id                 String    @id @default(cuid())
  workspaceId        String
  type               EventType
  occurredAt         DateTime
  leadId             String?
  campaignId         String?
  accountId          String?
  stepId             String?
  variantId          String?
  scheduledMessageId String?
  messageId          String?
  isEstimated        Boolean   @default(false)
  meta               Json      @default("{}")
  dedupeKey          String    @unique
  createdAt          DateTime  @default(now())

  @@index([workspaceId, type, occurredAt])
  @@index([campaignId, type])
  @@index([leadId, occurredAt])
}

model SyncRun {
  id         String       @id @default(cuid())
  accountId  String
  account    EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mode       SyncMode
  startedAt  DateTime
  finishedAt DateTime?
  fetched    Int          @default(0)
  error      String?

  @@index([accountId, startedAt])
}

// A note on a thread or on a lead (exactly one; CHECK in the migration). leadId carries no FK: GDPR erasure deletes it explicitly.
model Note {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  threadId    String?
  thread      Thread?   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  leadId      String?
  authorId    String? // null for an API key
  body        String
  createdAt   DateTime  @default(now())

  @@index([workspaceId, threadId])
  @@index([workspaceId, leadId])
}

model Macro {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  body        String

  @@unique([workspaceId, name])
}

model InboxView {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  filters     Json
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, name])
}

// Latest DNS check per sending domain (D35); selectors are the user's extra DKIM selectors.
model DomainCheck {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  domain      String
  checkedAt   DateTime
  level       String // ok | warn | block
  report      Json
  selectors   String[]

  @@unique([workspaceId, domain])
}

// D34: one health score per account and local day (the trend); EmailAccount.healthScore holds the current one.
model HealthSnapshot {
  accountId String
  account   EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  day       DateTime     @db.Date
  score     Int

  @@id([accountId, day])
}

enum WarmupKind {
  SEND
  REPLY
  PLACEMENT
}

enum WarmupStatus {
  PLANNED
  SENDING
  SENT
  FAILED
}

// D36: cooperative warm-up between mailboxes of one workspace whose owner enabled it on both ends.
model WarmupSettings {
  accountId      String       @id
  account        EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  workspaceId    String
  enabled        Boolean      @default(false)
  dailyLimit     Int          @default(10)
  slowWarmup     Boolean      @default(true)
  startVolume    Int          @default(1)
  increasePerDay Int          @default(1)
  customCurve    Json? // [{day, volume}], at most 90 entries
  replyRatePct   Int          @default(30)
  weekdaysOnly   Boolean      @default(false)
  filterTag      String
  startedAt      DateTime?
  nextAt         DateTime?
  updatedAt      DateTime     @updatedAt

  @@index([workspaceId])
}

// D36 / D37: warm-up and placement traffic lives only here, never in Thread / Message / Event.
model WarmupMessage {
  id              String       @id @default(cuid())
  workspaceId     String
  fromAccountId   String
  from            EmailAccount @relation("WarmupFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccountId     String
  to              EmailAccount @relation("WarmupTo", fields: [toAccountId], references: [id], onDelete: Cascade)
  kind            WarmupKind
  status          WarmupStatus @default(PLANNED)
  rfcMessageId    String       @unique
  subject         String
  parentId        String?
  placementTestId String?
  dueAt           DateTime
  sentAt          DateTime? // while SENDING: when the send was claimed
  receivedAt      DateTime?
  landedFolder    String? // INBOX | SPAM | OTHER | MISSING
  checkedAt       DateTime?
  error           String?
  createdAt       DateTime     @default(now())

  @@index([fromAccountId, sentAt])
  @@index([toAccountId, receivedAt])
  @@index([status, dueAt])
}
